            </h3>
            <form
              class="space-y-6"
            >
              <div>
                <label
                  class="block text-sm font-medium mb-2"
                  for="name"
                >
                   
                  Your Name
                </label>
                <input
                  class="w-full px-4 py-3 rounded-md border border-border bg-card text-foreground
                  placeholder:text-muted-foreground/50
                  focus:outline-hidden foucs:ring-2 focus:ring-primary/20 focus:border-primary
                  transition-all duration-200"
                  id="name"
                  name="name"
                  placeholder="Peter Smith..."
                  required=""
                  type="text"
                />
              </div>
              <div>
                <label
                  class="block text-sm font-medium mb-2"
                  for="email"
                >
                   
                  Your Email
                </label>
                <input
                  class="w-full px-4 py-3 rounded-md border border-border bg-card text-foreground
                  placeholder:text-muted-foreground/50
                  focus:outline-hidden foucs:ring-2 focus:ring-primary/20 focus:border-primary
                  transition-all duration-200"
                  id="email"
                  name="email"
                  placeholder="Peter.Smith@gmail.com"
                  required=""
                  type="email"
                />
              </div>
              <div>
                <label
                  class="block text-sm font-medium mb-2"
                  for="message"
                >
                   
                  Your Message
                </label>
                <textarea
                  class="w-full px-4 py-3 rounded-md border border-border bg-card text-foreground
                  placeholder:text-muted-foreground/50
                  focus:outline-hidden foucs:ring-2 focus:ring-primary/20 focus:border-primary
                  transition-[color,box-shadow,border-color] duration-200 min-h-[100px]"
                  id="message"
                  name="message"
                  placeholder="Hello, I'd like to talk about..."
                  required=""
                />
              </div>
              <button
                class="cosmic-button w-full flex items-center justify-center gap-2"
                type="submit"
              >
                Send Message
